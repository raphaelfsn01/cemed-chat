# Caddy — reverse proxy + HTTPS automático (Let's Encrypt) para o DeskcommCRM.
# HTTP→HTTPS e emissão/renovação de certificado são automáticos.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# HSTS: o navegador que já entrou por HTTPS não volta a tentar HTTP por 6
	# meses (15768000 s) — fecha o downgrade num Wi-Fi hostil, que o redirect
	# HTTP→HTTPS sozinho não fecha (o primeiro pedido ainda sai em claro).
	# Sem includeSubDomains: outros subdomínios do mesmo domínio não são deste
	# servidor e não podem herdar a regra. Sem preload: entrar na lista dos
	# navegadores é praticamente irreversível. O Caddy só envia o header nas
	# respostas HTTPS; o redirect da porta 80 não o leva, como pede a RFC 6797.
	header Strict-Transport-Security "max-age=15768000"

	# Log de ACESSO (uma linha JSON por requisição). Sem ele não havia como
	# auditar nada pelo servidor — nem responder "alguma senha passou na URL?".
	# Como consultar: docs/runbooks/caddy-log-de-acesso.md.
	#
	# Fica em /data, que é o volume `caddy-data`: sobrevive a restart e a
	# recriação do contêiner. Rotação: arquivo novo a cada 10 MiB, guarda 10
	# arquivos e nenhum com mais de 30 dias (≤ ~110 MiB no total).
	#
	# O que entra: data, método, URI (redigida), status, duração, tamanhos, IP de
	# origem e o User-Agent. NADA além disso — e é por lista BRANCA:
	# - headers de requisição e de resposta saem INTEIROS do log, e só o
	#   User-Agent volta (`log_append`). Por lista negra eles vazavam: o app
	#   devolve `X-Pathname` com o caminho completo (o token do convite junto),
	#   o `Location` do redirect leva `?next=<caminho>`, o `Content-Disposition`
	#   de exportação leva nome de arquivo, e a navegação do Next manda
	#   `Next-Url`/`Next-Router-State-Tree` com os parâmetros da rota. Header
	#   novo que o app passe a emitir não entra no log sem ninguém decidir.
	# - corpo de requisição/resposta: o Caddy nunca registra corpo.
	# - na URI, viram REDACTED: o token no caminho (webhook por canal, convite),
	#   o mesmo caminho quando vem codificado dentro de um parâmetro
	#   (`?next=%2Fteam%2Faccept-invite%2F<token>`), e o valor de todo parâmetro
	#   cujo NOME contém token, secret, password/senha/pass, code, key, email,
	#   search ou cpf (pega `token_hash` dos links do Supabase e a busca, que
	#   pode ser nome/telefone/CPF de paciente) — inclusive quando o parâmetro
	#   vem codificado dentro do `next` de um redirect
	#   (`?next=%2Fapp%2Fcontacts%3Fsearch%3D<valor>`). Critério de caminho igual ao
	#   do scrub do Sentry (lib/sentry/scrub.ts, CREDENTIAL_PATH).
	# Provado de ponta a ponta com o app de verdade atrás de um Caddy
	# descartável (docs/runbooks/caddy-log-de-acesso.md): o token de teste não
	# aparece em campo nenhum do arquivo.
	# O IP de origem fica (é o que serve para auditoria de segurança) — por
	# isso o log também é dado pessoal, e a retenção é curta (30 dias).
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
			request>uri multi_regexp {
				regexp "(/api/v1/webhooks/[^/?#]+/|/team/accept-invite/)[^/?#]+" "${1}REDACTED"
				regexp "((?i:%2Fapi%2Fv1%2Fwebhooks%2F)[^&#%]+(?i:%2F)|(?i:%2Fteam%2Faccept-invite%2F))[^&#%]+" "${1}REDACTED"
				regexp "([?&][^=&#]*(?i:token|secret|password|senha|pass|code|key|email|search|cpf)[^=&#]*=)[^&#]*" "${1}REDACTED"
				regexp "((?i:%3F|%26)[^=&#%]*(?i:token|secret|password|senha|pass|code|key|email|search|cpf)[^=&#%]*(?i:%3D))[^&#%]*" "${1}REDACTED"
			}
		}
	}
	log_append user_agent {http.request.header.User-Agent}

	# `route` é obrigatório aqui: fora dele o Caddy reordena as diretivas pela
	# ordem padrão dele, na qual `respond` vem DEPOIS de `reverse_proxy` — o
	# catch-all atendia primeiro e o 403 abaixo nunca era alcançado (medido: o
	# POST sem assinatura ainda respondia 200). Dentro de `route`, vale a ordem
	# escrita.
	route {
		# O webhook GLOBAL do WAHA (sem token na URL) não é publicado na internet.
		#
		# Nesta stack o WAHA fala com o app pela rede interna do Docker
		# (http://app:3000/api/v1/webhooks/waha), então essa rota nunca precisou ser
		# alcançável de fora — e estando aberta, qualquer pessoa que soubesse o
		# endereço injetava mensagem falsa no CRM, escolhia o remetente e fazia o
		# WhatsApp do dono responder para um número arbitrário (queimando o
		# orçamento de IA e arriscando banimento do número).
		#
		# Quem roda o WAHA em OUTRO servidor deve usar a rota por tenant,
		# /api/v1/webhooks/waha/<token>, que carrega um token imprevisível na URL e
		# continua pública — é a variante canônica para essa topologia.
		@waha_global path /api/v1/webhooks/waha
		respond @waha_global 403

		# Rotas de máquina não são publicadas na internet: /api/internal/* (o
		# runner do agente) e /api/v1/cron/* (os crons). Quem as chama está na
		# rede interna do compose e fala direto com http://app:3000: o `scheduler`
		# (crontab em docker-compose.prod.yml) e o próprio app (INTERNAL_APP_URL,
		# em lib/ai/dispatcher). Abertas, a única barreira era o segredo no
		# header — vazou o segredo, qualquer um disparava os crons de fora.
		#
		# O agente de atualização do host (hostgator-setup-kit/agent.sh) usa
		# /api/v1/system/agent, que continua passando: o host não enxerga a rede
		# interna e só chega ao app pelo domínio.
		#
		# O matcher de caminho do Caddy ignora maiúsculas e compara o caminho já
		# decodificado: /API/internal/... e /api/%69nternal/... caem aqui também.
		@maquina path /api/internal /api/internal/* /api/v1/cron /api/v1/cron/*
		respond @maquina 403

		# Todo o resto do app.
		reverse_proxy app:3000
	}
}
