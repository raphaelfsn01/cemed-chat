# Credenciais do backup externo (scripts/backup/backup.sh).
#
# Copie para ~/.config/cemed-backup/backup.env, deixe com permissão 600
# (chmod 600) e preencha NA VPS. Nunca versione o arquivo preenchido nem cole
# os valores em chat ou ticket. O script recusa arquivo que não seja 600 e do
# próprio usuário, e recusa chave que não esteja nesta lista.
# Formato: CHAVE=valor por linha, sem `export`. Aspas em volta são opcionais.
# O arquivo é lido como dado, não executado: `$` na senha não expande.

# Banco (Supabase). Use o "Session pooler" (porta 5432, usuário postgres.<ref>),
# que é IPv4 e aceita pg_dump. Não use o transaction pooler (6543).
SUPABASE_DB_URL=
# Storage, para copiar a mídia dos buckets privados.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: token "Object Read & Write" restrito ao bucket do backup.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cemed-backups-prod

# healthchecks.io: URLs de ping (https://hc-ping.com/<uuid>).
HC_PING_URL=
# Usado pelo teste de restauração trimestral.
HC_RESTORE_PING_URL=

# Chave PÚBLICA age (age1...). A privada nunca fica nesta máquina.
AGE_RECIPIENT=

# Opcionais
# BACKUP_MEDIA_BUCKETS=whatsapp-media        # buckets copiados, separados por espaço
# R2_ENDPOINT=https://<conta>.r2.cloudflarestorage.com   # padrão: derivado do R2_ACCOUNT_ID
# R2_REGION=auto
